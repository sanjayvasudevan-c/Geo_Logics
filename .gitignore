# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment / secrets ---
.env
.env.*
*.pem
*.key

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data & weights (never commit large/raw assets) ---
data/raw/*
data/interim/*
data/processed/*
*.tif
*.tiff
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors
*.h5

# --- Logs / experiment outputs ---
logs/
runs/
mlruns/
wandb/
reports/figures/*.png
!reports/figures/.gitkeep

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Benchmark quarantine (see CLAUDE.md §7) ---
data/benchmark_eval/*

# --- Stage S1 additions -------------------------------------------------------------
# Environments. NOTE: uv.lock is deliberately NOT ignored — the pinned lockfile is what
# makes `make reproduce` and CLAUDE.md §8 reproducibility real. It must be committed.
.venv/

# Model checkpoints and weights
models/*

# Per-run artifacts (regenerable; the registry that writes them is code)
reports/runs/*

# Tooling caches
.ruff_cache/
.mypy_cache/

# Keep the directory skeleton on a fresh clone, even inside ignored trees.
!**/.gitkeep
